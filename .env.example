# ── Blockbuster configuration ─────────────────────────────────────────
# Copy this file to `.env` (or export the vars in your shell) and fill in.
# NONE of the Python scripts contain secrets — see "Secrets" in the README.

# Where newly-generated editions land (the agent writes blockbuster_YYYY-MM-DD.html here)
BB_SRC_DIR=~/blockbuster/editions

# Directory the web server serves the archive from
BB_STATIC_DIR=static/blockbuster

# Public base URL printed by the publish script on success
BB_PUBLIC_URL=http://localhost:8678/blockbuster/

# Poster JPEG folder for the build step
BB_POSTER_DIR=posters

# ── External API keys ─────────────────────────────────────────────────
# The ONLY external service that needs a key is Firecrawl, used as the
# web-search / web-extract backend to discover films and scrape IMDb pages.
# This key does NOT live in this repo's code — put it in your agent's own
# config (e.g. Hermes config.yaml / .env), never here.
FIRECRAWL_API_KEY=your_firecrawl_key_here
